# Copia este archivo a .env y completa los valores.

# Panel didáctico con IA real (multi-LLM vía OpenRouter). Sin key, la app usa
# un mock de IA que streamea fixtures por el mismo pipeline.
OPENROUTER_API_KEY=

# Opcional: override del modelo de IA a nivel de entorno. El modelo se elige
# normalmente desde Settings en la UI (default z-ai/glm-5.2); esta variable
# solo aplica si no hay nada guardado en Settings.
# MINERVA_AI_MODEL=z-ai/glm-5.2

# Opcional (Linux): backend del password store de Chromium para safeStorage.
# En desktops no reconocidos (Hyprland/sway) la app ya fuerza gnome-libsecret;
# usa esto solo si tu setup necesita otro (p. ej. kwallet6 o basic).
# MINERVA_PASSWORD_STORE=gnome-libsecret
